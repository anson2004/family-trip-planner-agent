# ---- The trip to plan ----
# Finnish city (Tampere, Helsinki, Turku, Oulu, ...) or a 3-letter airport code.
# Comma-separate to allow several departure cities; the first one is home (preferred, no transfer cost).
TRIP_FROM=Tampere
# City, island, region or country. Comma-separate up to 5 to compare them in one plan,
# e.g. Gran Canaria,Tenerife,Madeira
TRIP_TO=Gran Canaria
# Optional: return-trip ground cost per traveller to other departure airports, e.g. TKU:40,HEL:50
TRIP_TRANSFER_COSTS=
# YYYY-MM-DD. Without TRIP_DAYS these are the exact travel dates.
# With TRIP_DAYS they are the search window: leave on/after TRIP_DEPART, be back by TRIP_RETURN.
TRIP_DEPART=2027-02-14
TRIP_RETURN=2027-02-28
# Optional trip length in days (days between leaving and coming back), e.g. 7.
# The agent finds the cheapest dates in the window first (1 extra search per destination).
TRIP_DAYS=7
# Total EUR for flights + accommodation for everyone: 3500 (max) or 2000-3500 (range)
TRIP_BUDGET=2000-3500
TRIP_ADULTS=2
# Comma-separated child ages, e.g. 6 or 6,3. Leave empty for no children.
TRIP_CHILDREN_AGES=6
# Optional: 0 = nonstop only, 1 or 2 = maximum stops each way
TRIP_MAX_STOPS=
# Optional: minimum hotel guest rating, e.g. 4.0
TRIP_MIN_RATING=
# Optional: free-text wishes
TRIP_NOTES=near the beach, kids pool

# ---- API keys ----
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Google Flights + Google Hotels. Free plan: https://serpapi.com/users/sign_up
SERPAPI_API_KEY=
# Optional: travel-agency package search. Free plan: https://app.tavily.com
TAVILY_API_KEY=

# Optional: email the plan with Resend (https://resend.com/api-keys).
# Sent after each run when both RESEND_API_KEY and EMAIL_TO are set; use --no-email to skip.
RESEND_API_KEY=
# Comma-separated recipients
EMAIL_TO=
# Without your own verified domain, keep onboarding@resend.dev: it can only send to your Resend account's email.
EMAIL_FROM=Trip Planner <onboarding@resend.dev>

# ---- Agent settings ----
# Any Groq model with tool calling, see https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high (gpt-oss only). Lower = fewer output tokens.
GROQ_REASONING_EFFORT=low
# Live SerpApi searches allowed per plan (cached repeats are free).
# Empty = automatic: 4 + 2 per destination (+1 per destination with TRIP_DAYS).
MAX_SERPAPI_CALLS=
