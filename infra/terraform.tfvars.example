# Copy to terraform.tfvars (git-ignored) and fill in. API keys do NOT go here: run set-secrets.sh.
project_id = "travel-plan-agent-123456"

# Optional (defaults shown)
# region           = "europe-north1"
# scheduler_region = "europe-west1"
# schedule         = "0 8 * * 1"   # Mondays 08:00
# time_zone        = "Europe/Helsinki"
# secrets          = ["GROQ_API_KEY", "SERPAPI_API_KEY", "TAVILY_API_KEY", "RESEND_API_KEY"]

# Everything from your .env except the API keys. Same names and values.
settings = {
  TRIP_FROM          = "Tampere"
  TRIP_TO            = "Gran Canaria"
  # No TRIP_DEPART / TRIP_RETURN: each run searches from tomorrow to 2 months later.
  TRIP_DAYS          = "7"
  TRIP_BUDGET        = "2000-3500"
  TRIP_ADULTS        = "2"
  TRIP_CHILDREN_AGES = "6"
  EMAIL_TO           = "you@example.com"
}
